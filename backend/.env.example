# WhatsApp CRM - Backend environment
# Copy to .env and fill in real values.

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# Local dev (SQLite, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Supabase Postgres (production) - replace user/pass/host:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.REF.supabase.co:5432/postgres?sslmode=require

# --- Supabase Storage (optional for local; required in production) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=whatsapp-media

# --- Meta WhatsApp Cloud API (fallback defaults; per-user config lives in Settings) ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_ACCESS_TOKEN=
WHATSAPP_DEFAULT_PHONE_NUMBER_ID=
WEBHOOK_DEFAULT_VERIFY_TOKEN=change-me-verify-token

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-frontend.vercel.app
